# AI Provider Configuration
# Cloudflare Workers AI is used by the chatbot.
# Create an API token in Cloudflare with Workers AI access.
# IMPORTANT:
# - Never commit the actual .env file
# - Keep keys secure and rotate regularly
# Add these same values in Render Dashboard > Environment.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_TIMEOUT_SECONDS=15
ALLOWED_ORIGINS=https://your-extra-frontend-domain.com

# Gmail Configuration
# For GMAIL_APP_PASSWORD:
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Generate App Password:
#    - Go to Google Account > Security > 2-Step Verification > App Passwords
#    - Select 'Mail' and your device
#    - Use the generated 16-character password
GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
SMTP_TIMEOUT_SECONDS=8
MAX_JSON_BYTES=32768

# Optional frontend override. Leave empty on Render if Flask serves the React build.
VITE_API_BASE_URL=

# Security Settings
RATE_LIMIT_PER_MINUTE=60
MAX_TOKENS_PER_REQUEST=1000

# AI Provider Configuration
# Gemini key is primary. OpenRouter is fallback.
# Gemini key: https://makersuite.google.com/app/apikey
# OpenRouter key: https://openrouter.ai/keys
# IMPORTANT:
# - Never commit the actual .env file
# - GEMINI_API_KEY_1 is primary
# - GEMINI_API_KEY_2 is optional Gemini fallback
# - OPENROUTER_API_KEY is used if Gemini fails
# - Keep keys secure and rotate regularly
# Add these same values in Render Dashboard > Environment.
GEMINI_API_KEY_1=your_gemini_api_key_here
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=180
GEMINI_TIMEOUT_SECONDS=15
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_SECONDS=12
ALLOWED_ORIGINS=https://your-extra-frontend-domain.com

# Gmail Configuration
# For GMAIL_APP_PASSWORD:
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Generate App Password:
#    - Go to Google Account > Security > 2-Step Verification > App Passwords
#    - Select 'Mail' and your device
#    - Use the generated 16-character password
GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
SMTP_TIMEOUT_SECONDS=8
MAX_JSON_BYTES=32768

# Optional frontend override. Leave empty on Render if Flask serves the React build.
VITE_API_BASE_URL=

# Security Settings
RATE_LIMIT_PER_MINUTE=60
MAX_TOKENS_PER_REQUEST=1000

# Frontend Environment Variables
# Copy to .env and customize if needed

# Override backend URL (only needed if not using default localhost)
# Leave empty to auto-detect: http://127.0.0.1:8000 (localhost) or same-origin (production)
VITE_API_BASE_URL=

# Examples:
# VITE_API_BASE_URL=http://127.0.0.1:8000        # Local backend
# VITE_API_BASE_URL=https://my-backend.com       # Remote backend
# VITE_API_BASE_URL=                              # Auto-detect (default)

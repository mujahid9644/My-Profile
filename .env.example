# Copy backend/.env.example to backend/.env for local backend development.
# On Render, add these variables in Dashboard > Environment.

GEMINI_API_KEY_1=your_gemini_api_key_here
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=180

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_SECONDS=20

GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_google_app_password
SMTP_TIMEOUT_SECONDS=8

# Optional. Comma-separated extra domains beyond localhost and Render default.
ALLOWED_ORIGINS=

# Optional. Leave empty on Render when Flask serves the React build.
VITE_API_BASE_URL=
